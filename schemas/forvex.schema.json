{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nibblet/reecosystem-core/main/schemas/forvex.schema.json",
  "title": "forVEX app registry card",
  "description": "One forvex.json at the root of each nibblet app repo. Not app.json (Expo uses that). Agents update when stage/version/URL/marketing changes. Never put secrets here. Fields: name (repo id), repo (nibblet/<name>), display_name, default_branch, tier (A critical/B key/C personal/P parked/X sunset), stage (Idea/Prototype/Beta/Live/Maintenance/Parked/Sunset), version, build, platform, stack, hosting, live_url, custom_domain, monorepo_path, sign_in, supabase (project name only), app_store_status, app_store_id, marketing_status, marketing_url, privacy_url, terms_url, support_email, owner_bot, review_by (required if Parked), notes, updated (YYYY-MM-DD).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "repo", "display_name", "tier", "stage", "platform", "hosting", "updated"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "repo": { "type": "string", "pattern": "^nibblet/[A-Za-z0-9._-]+$" },
    "display_name": { "type": "string" },
    "default_branch": { "type": "string", "default": "main" },
    "tier": { "enum": ["A", "B", "C", "P", "X"] },
    "stage": { "enum": ["Idea", "Prototype", "Beta", "Live", "Maintenance", "Parked", "Sunset"] },
    "version": { "type": "string" },
    "build": { "type": "string" },
    "platform": { "enum": ["web", "pwa", "ios-swift", "ios-expo", "docs", "static-site", "python"] },
    "stack": { "type": "string" },
    "hosting": { "enum": ["vercel", "cloudflare-workers", "cloudflare-pages", "app-store", "personal-install", "eas", "none"] },
    "live_url": { "type": "string" },
    "custom_domain": { "type": "string" },
    "monorepo_path": { "type": "string" },
    "sign_in": { "type": "string" },
    "supabase": { "enum": ["reecosystem", "paul_personal", "separate", "none", "unknown"] },
    "app_store_status": { "enum": ["none", "personal_install", "testflight", "live", "not_applicable"] },
    "app_store_id": { "type": "string" },
    "marketing_status": { "enum": ["none", "site_only", "social", "active"] },
    "marketing_url": { "type": "string" },
    "privacy_url": { "type": "string" },
    "terms_url": { "type": "string" },
    "support_email": { "type": "string" },
    "owner_bot": { "type": "string", "default": "Code Lead" },
    "review_by": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "updated": { "type": "string", "format": "date" }
  },
  "if": { "properties": { "stage": { "const": "Parked" } }, "required": ["stage"] },
  "then": { "required": ["review_by"] }
}
